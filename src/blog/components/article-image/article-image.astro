---
import { Picture } from 'astro:assets'
import type { ImageMetadata, ImageOutputFormat } from 'astro'

type Props = {
  src: ImageMetadata
  alt?: string
  caption?: string
  ariaLabelledBy?: string
}

const { src, alt = '', caption, ariaLabelledBy } = Astro.props

const captionId =
  ariaLabelledBy ??
  `caption-${caption
    ?.toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')}`

const formats: ImageOutputFormat[] = ['avif']
const fallbackFormat = 'webp'
---

{caption ? (
  <figure class="article-picture" aria-labelledby={captionId}>
    <Picture
      src={src}
      alt={alt}
      formats={formats}
      fallbackFormat={fallbackFormat}
    />
    <figcaption class="fig-caption" id={captionId}>
      {caption}
    </figcaption>
  </figure>
) : (
  <Picture
    class="article-picture"
    src={src}
    alt={alt}
    formats={formats}
    fallbackFormat={fallbackFormat}
  />
)}

<style>
  .article-picture {
    margin: var(--space-lg) 0;
  }

  .fig-caption {
    margin-top: var(--space-sm);
    color: var(--text-meta);
    font-size: var(--font-size-sm);
    text-align: center;
  }
</style>
