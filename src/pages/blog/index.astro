---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import ArticleCard from '~/components/article-card/article-card.astro'

const allPosts = await getCollection('blog')
const posts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)
---

<Base
  title="Blog • Krzysztof Sordyl"
  description="Technical articles on modern frontend development, testing strategies, and JavaScript ecosystem. Featuring detailed guides on testing, architecture and frontend solutions."
  ogDescription="Insights on frontend architecture, testing strategies, and modern JavaScript development."
>
  <header class="page-header">
    <h1 class="page-title">Latest posts</h1>
    <p class="page-description">All of my long-form thoughts on programming</p>
  </header>
  <section class="grid">
    {posts.map((post) => (
      <ArticleCard
        href={`/blog/${post.id}/`}
        title={post.data.title}
        excerpt={post.data.excerpt}
        date={post.data.date}
        ctaLabel="Read article"
        headingLevel="h2"
      />
    ))}
  </section>
</Base>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .page-title {
    color: var(--heading-color);
    font-size: var(--font-size-3xl);
    font-weight: 700;
    line-height: 1.5;
  }

  .page-description {
    color: var(--text-color);
    font-size: var(--font-size-md);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-2xl);
  }

  @media screen and (min-width: 520px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    }
  }
</style>
