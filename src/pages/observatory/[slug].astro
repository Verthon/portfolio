---
import { getCollection, render } from 'astro:content'
import Article from '~/layouts/Article.astro'
import Base from '~/layouts/Base.astro'
import { createArticleJsonLd } from '~/seo/article-json-ld'

export async function getStaticPaths() {
  const posts = await getCollection('observatory')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const canonical = new URL(Astro.url.pathname, Astro.site).href

const jsonLd = createArticleJsonLd({
  title: post.data.title,
  canonical,
  date: post.data.date,
  lastUpdated: post.data.last_updated,
})
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogTitle={post.data.og_title || post.data.title}
  ogDescription={post.data.og_description || post.data.description}
  ogType="article"
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={post.data.date.toISOString()}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    ></script>
  </Fragment>
  <Article>
    <Content />
  </Article>
</Base>
