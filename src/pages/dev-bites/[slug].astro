---
import { getCollection, render } from 'astro:content'
import Article from '~/layouts/Article.astro'
import Base from '~/layouts/Base.astro'

export async function getStaticPaths() {
  const posts = await getCollection('devBites')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const canonical = new URL(Astro.url.pathname, Astro.site).href
const iso = (d) => d.toISOString().slice(0, 10)
const person = {
  '@type': 'Person',
  '@id': 'https://sordyl.dev/#person',
  name: 'Krzysztof Sordyl',
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  datePublished: iso(post.data.date),
  dateModified: iso(post.data.last_updated ?? post.data.date),
  author: person,
  publisher: person,
}
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogTitle={post.data.og_title || post.data.title}
  ogDescription={post.data.og_description || post.data.description}
  ogType="article"
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={post.data.date.toISOString()}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    ></script>
  </Fragment>
  <Article>
    <Content />
  </Article>
</Base>
